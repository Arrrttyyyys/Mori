# Browser-safe Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never prefix this key with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Configure at least one model provider for production.
OPENAI_API_KEY=
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Database migrations only; keep this server-side.
DATABASE_URL=
# Optional newer Supabase secret key (instead of SUPABASE_SERVICE_ROLE_KEY).
# SUPABASE_SECRET_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Local Hugging Face model (start with npm run model:start).
MORI_AI_PROVIDER=local
MORI_LOCAL_URL=http://127.0.0.1:8080
MORI_LOCAL_MODEL=mlx-community/Qwen3.5-2B-4bit
MORI_STAGING_SUPABASE_URL=
MORI_STAGING_SUPABASE_ANON_KEY=
MORI_STAGING_SERVICE_ROLE_KEY=
MORI_STAGING_DATABASE_URL=
MORI_STAGING_APP_URL=
MORI_RESTORE_DATABASE_URL=
# Exact value required only while running the disposable staging privacy drill:
MORI_STAGING_ALLOW_DESTRUCTIVE=

# Public demo protection. Use distinct random values in production.
MORI_DEMO_ACCESS_CODE=
MORI_DEMO_COOKIE_SECRET=
MORI_MONITORING_HASH_SALT=
MORI_DEMO_DAILY_TURN_LIMIT=60

# Read-only operations endpoint: GET /api/operations/metrics
MORI_OPERATIONS_TOKEN=
# Public address used in the privacy notice before inviting real participants.
NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL=

# Optional private malware-scanning service. Required for audio/video uploads.
# It must accept raw bytes and return JSON: {"clean":true}.
MORI_FILE_SCAN_URL=
MORI_FILE_SCAN_TOKEN=
